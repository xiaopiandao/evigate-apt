{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/evigate/llm-response-v3.schema.json",
  "title": "EviGate-LLM compact evidence certificate v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "tactic",
    "evidence_sufficient",
    "integrity_alarm",
    "confidence",
    "support_process_ref",
    "cited_anchor_ids",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "case_id": {"type": "string", "pattern": "^case_[0-9a-f]{20}$"},
    "tactic": {
      "type": ["string", "null"],
      "enum": ["collection", "command_and_control", "credential_access", "discovery", "exfiltration", null]
    },
    "evidence_sufficient": {"type": "boolean"},
    "integrity_alarm": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "support_process_ref": {"type": ["string", "null"], "pattern": "^P(?:[1-9]|10)$"},
    "cited_anchor_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 6,
      "items": {"type": "string", "pattern": "^P(?:[1-9]|10)\\.[a-z_]+$"}
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "enum": ["sufficient_observed_support", "missing_process_evidence", "insufficient_process_evidence", "conflicting_cross_view_evidence", "temporal_mismatch", "ambiguous_tactic", "suspected_evidence_corruption"]
      }
    }
  }
}
