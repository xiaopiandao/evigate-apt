{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/evigate/llm-response-v2.schema.json",
  "title": "EviGate-LLM evidence-contracted response v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "tactic",
    "evidence_sufficient",
    "integrity_alarm",
    "confidence",
    "cited_entity_ids",
    "cited_anchor_ids",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "case_id": {"type": "string", "pattern": "^case_[0-9a-f]{20}$"},
    "tactic": {
      "type": ["string", "null"],
      "enum": ["collection", "command_and_control", "credential_access", "discovery", "exfiltration", null]
    },
    "evidence_sufficient": {"type": "boolean"},
    "integrity_alarm": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "cited_entity_ids": {"type": "array", "uniqueItems": true, "maxItems": 5, "items": {"type": "string"}},
    "cited_anchor_ids": {"type": "array", "uniqueItems": true, "maxItems": 30, "items": {"type": "string"}},
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "enum": ["sufficient_observed_support", "missing_process_evidence", "insufficient_process_evidence", "conflicting_cross_view_evidence", "temporal_mismatch", "ambiguous_tactic", "suspected_evidence_corruption"]
      }
    }
  }
}
